{
  "title": "Benchmarks por algoritmo (cAdvisor)",
  "uid": "cadvisor-algorithm",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "algorithm",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(container_label_algorithm)",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU (taxa de uso)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (container_label_algorithm) (rate(container_cpu_usage_seconds_total{container_label_algorithm=~\"$algorithm\"}[1m]))",
          "legendFormat": "{{container_label_algorithm}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Memoria (uso)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (container_label_algorithm) (container_memory_usage_bytes{container_label_algorithm=~\"$algorithm\"})",
          "legendFormat": "{{container_label_algorithm}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Rede (rx/tx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (container_label_algorithm) (rate(container_network_receive_bytes_total{container_label_algorithm=~\"$algorithm\"}[1m]))",
          "legendFormat": "{{container_label_algorithm}} rx",
          "refId": "A"
        },
        {
          "expr": "sum by (container_label_algorithm) (rate(container_network_transmit_bytes_total{container_label_algorithm=~\"$algorithm\"}[1m]))",
          "legendFormat": "{{container_label_algorithm}} tx",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "title": "Disco (leitura/escrita)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (container_label_algorithm) (rate(container_fs_reads_bytes_total{container_label_algorithm=~\"$algorithm\"}[1m]))",
          "legendFormat": "{{container_label_algorithm}} read",
          "refId": "A"
        },
        {
          "expr": "sum by (container_label_algorithm) (rate(container_fs_writes_bytes_total{container_label_algorithm=~\"$algorithm\"}[1m]))",
          "legendFormat": "{{container_label_algorithm}} write",
          "refId": "B"
        }
      ]
    }
  ]
}
