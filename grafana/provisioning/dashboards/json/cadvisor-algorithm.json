{
  "title": "Benchmarks por algoritmo (cAdvisor)",
  "uid": "cadvisor-algorithm",
  "schemaVersion": 39,
  "version": 17,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "algorithm",
        "label": "Algoritmo",
        "type": "custom",
        "query": "KEM,DSS,MCELIECE,ECIES,ECDSA,ECDH",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "options": [
          { "text": "KEM", "value": "KEM" },
          { "text": "DSS", "value": "DSS" },
          { "text": "MCELIECE", "value": "MCELIECE" },
          { "text": "ECIES", "value": "ECIES" },
          { "text": "ECDSA", "value": "ECDSA" },
          { "text": "ECDH", "value": "ECDH" }
        ]
      },
      {
        "name": "effort",
        "label": "Nível de segurança",
        "type": "custom",
        "query": "1,3,5",
        "multi": true,
        "includeAll": true,
        "allValue": "1|3|5",
        "current": { "text": "All", "value": "$__all" },
        "options": [
          { "text": "1", "value": "1" },
          { "text": "3", "value": "3" },
          { "text": "5", "value": "5" }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU (ocupação de 1 núcleo)",
      "description": "Taxa de uso de CPU do container (média móvel de 1 min, em fração de 1 núcleo). Mede ocupação, não custo por operação — para custo, use o painel 'CPU por operação'. Requer o label 'effort' (-l effort=<N>).",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean"] }
      },
      "targets": [
        {
          "expr": "label_join(sum by (container_label_algorithm, container_label_effort) (rate(container_cpu_usage_seconds_total{container_label_algorithm=~\"$algorithm\", container_label_effort=~\"$effort\"}[1m])), \"algo_effort\", \" · nível \", \"container_label_algorithm\", \"container_label_effort\")",
          "legendFormat": "{{algo_effort}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Memoria (uso)",
      "description": "Memória do container vista pelo cAdvisor nos últimos 15 s. Requer o label 'effort' (-l effort=<N>).",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean"] }
      },
      "targets": [
        {
          "expr": "label_join(sum by (container_label_algorithm, container_label_effort) (container_memory_usage_bytes{container_label_algorithm=~\"$algorithm\", container_label_effort=~\"$effort\"} and on (id, instance) (container_last_seen > time() - 15)), \"algo_effort\", \" · nível \", \"container_label_algorithm\", \"container_label_effort\")",
          "legendFormat": "{{algo_effort}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "CPU por operação (CPU-s por ciclo)",
      "description": "CPU total da execução dividida pelo volume (ciclos). Requer os labels 'volume' e 'effort' (-l volume=<N> -l effort=<N>).",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "CPU total (s)" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 2 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "CPU por operação (s)" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 2 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Volume" },
            "properties": [
              { "id": "unit", "value": "none" },
              { "id": "decimals", "value": 0 }
            ]
          }
        ]
      },
      "options": { "showHeader": true },
      "transformations": [
        { "id": "labelsToFields", "options": { "mode": "columns" } },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              { "targetField": "container_label_volume", "destinationType": "number" }
            ],
            "fields": {}
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": { "left": "Value", "operator": "/", "right": "container_label_volume" },
            "alias": "CPU por operação (s)",
            "replaceFields": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "container_label_algorithm": true,
              "container_label_effort": true
            },
            "renameByName": {
              "algo_effort": "Algoritmo / nível",
              "container_label_volume": "Volume",
              "Value": "CPU total (s)"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "label_join(sum by (container_label_algorithm, container_label_effort, container_label_volume) (last_over_time(container_cpu_usage_seconds_total{container_label_algorithm=~\"$algorithm\", container_label_effort=~\"$effort\", container_label_volume=~\".+\"}[$__range])), \"algo_effort\", \" · nível \", \"container_label_algorithm\", \"container_label_effort\")",
          "legendFormat": "{{container_label_algorithm}}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    },
    {
      "id": 4,
      "title": "Tempo medio por etapa",
      "description": "Tempo medio por etapa na ultima execucao enviada ao Pushgateway. 'keygen' e exibido por chamada; as demais etapas, por ciclo. Requer a imagem de profiling.",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 2 },
        "overrides": []
      },
      "options": { "showHeader": true },
      "transformations": [
        { "id": "labelsToFields", "options": { "mode": "columns" } },
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "step",
            "rowField": "algo_effort",
            "valueField": "Value"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": { "algo_effort\\step": "Algoritmo / nível" }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "label_join((sum by (algorithm, effort, step) (benchmark_step_seconds_sum{algorithm=~\"$algorithm\", effort=~\"$effort\"}) / ((sum by (algorithm, effort, step) (benchmark_step_seconds_count{algorithm=~\"$algorithm\", effort=~\"$effort\"}) unless on (algorithm, effort, step) sum by (algorithm, effort, step) (benchmark_step_seconds_count{step=\"keygen\", algorithm=~\"$algorithm\", effort=~\"$effort\"})) or sum by (algorithm, effort, step) (benchmark_step_calls{step=\"keygen\", algorithm=~\"$algorithm\", effort=~\"$effort\"}))), \"algo_effort\", \" · nível \", \"algorithm\", \"effort\") and on (algorithm, effort) (push_time_seconds >= $__from/1000 and push_time_seconds <= $__to/1000)",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    },
    {
      "id": 5,
      "title": "Tempo acumulado por etapa",
      "description": "Tempo total por etapa na ultima execucao enviada ao Pushgateway. A media por etapa esta no painel acima.",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 26 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 2 },
        "overrides": []
      },
      "options": { "showHeader": true },
      "transformations": [
        { "id": "labelsToFields", "options": { "mode": "columns" } },
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "step",
            "rowField": "algo_effort",
            "valueField": "Value"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": { "algo_effort\\step": "Algoritmo / nível" }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "label_join(sum by (algorithm, effort, step) (benchmark_step_seconds_sum{algorithm=~\"$algorithm\", effort=~\"$effort\"}), \"algo_effort\", \" · nível \", \"algorithm\", \"effort\") and on (algorithm, effort) (push_time_seconds >= $__from/1000 and push_time_seconds <= $__to/1000)",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    }
  ]
}
